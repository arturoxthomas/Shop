@model Shop.Web.Controllers.CatalogProductDetails
@{
    ViewData["Title"] = Model.Name;
}
<p><a asp-controller="Catalog" asp-action="Index">← Volver al catálogo</a></p>
<div class="row">
    <div class="col-md-6">
        @if (Model.Images.Count > 0)
        {
            <img src="@Model.Images[0].Url" alt="@(Model.Images[0].Alt ?? Model.Name)" class="img-responsive img-thumbnail" style="width:100%;max-height:420px;object-fit:contain" />
            @if (Model.Images.Count > 1)
            {
                <div class="row" style="margin-top:12px">
                    @foreach (var image in Model.Images.Skip(1))
                    {
                        <div class="col-xs-4"><img src="@image.Url" alt="@(image.Alt ?? Model.Name)" class="img-responsive img-thumbnail" /></div>
                    }
                </div>
            }
        }
        else
        {
            <div class="well text-center" style="padding:90px 15px">Imagen no disponible</div>
        }
    </div>
    <div class="col-md-6">
        <h1>@Model.Name</h1>
        <p class="text-muted">SKU: @Model.Sku</p>
        <p><strong>Categoría:</strong> @Model.Category</p>
        @if (!string.IsNullOrWhiteSpace(Model.Brand))
        {
            <p><strong>Marca:</strong> @Model.Brand</p>
        }
        <h2>B/. @Model.Price.ToString("N2")</h2>
        <p><strong>@(Model.Stock > 0 ? "Disponible" : "Agotado")</strong></p>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <h3>Descripción</h3>
            <p style="white-space:pre-line">@Model.Description</p>
        }
        @if (TempData["CartError"] is string cartError)
        {
            <div class="alert alert-warning">@cartError</div>
        }
        @if (Model.Stock >= 1)
        {
            <form asp-controller="Cart" asp-action="Add" method="post" class="form-inline">
                <input type="hidden" name="productId" value="@Model.Id" />
                <label for="quantity">Cantidad</label>
                <input id="quantity" name="quantity" type="number" value="1" min="1" max="99" class="form-control" style="width:85px" />
                <button type="submit" class="btn btn-success">Añadir al carrito</button>
            </form>
        }
        else
        {
            <p class="text-danger">Producto agotado</p>
        }
    </div>
</div>
