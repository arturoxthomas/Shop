@model Shop.Web.Models.CatalogAdminForm
@{ ViewData["Title"] = Model.Id == 0 ? "Nueva marca" : "Editar marca"; }
<h1>@ViewData["Title"]</h1>
<form asp-action="SaveBrand" method="post">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="form-group"><label asp-for="Name">Nombre</label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
    <div class="form-group"><label asp-for="Slug">Identificador URL</label><input asp-for="Slug" class="form-control" /><span asp-validation-for="Slug" class="text-danger"></span></div>
    <div class="checkbox"><label><input asp-for="IsActive" /> Activa</label></div>
    <button type="submit" class="btn btn-primary">Guardar</button> <a asp-action="Brands" class="btn btn-default">Cancelar</a>
</form>
