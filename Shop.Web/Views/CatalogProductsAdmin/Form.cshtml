@model Shop.Web.Models.CatalogProductForm
@{ ViewData["Title"] = Model.Id == 0 ? "Nuevo producto" : "Editar producto"; }
<h1>@ViewData["Title"]</h1>
<form asp-action="Save" method="post" enctype="multipart/form-data">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="row">
        <div class="col-md-6 form-group"><label asp-for="Sku">SKU</label><input asp-for="Sku" class="form-control" /><span asp-validation-for="Sku" class="text-danger"></span></div>
        <div class="col-md-6 form-group"><label asp-for="Name">Nombre</label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
        <div class="col-md-6 form-group"><label asp-for="Slug">Identificador URL</label><input asp-for="Slug" class="form-control" /><span asp-validation-for="Slug" class="text-danger"></span></div>
        <div class="col-md-6 form-group"><label asp-for="CategoryId">Categoría</label><select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-control"><option value="0">Selecciona una categoría</option></select><span asp-validation-for="CategoryId" class="text-danger"></span></div>
        <div class="col-md-6 form-group"><label asp-for="BrandId">Marca (opcional)</label><select asp-for="BrandId" asp-items="ViewBag.Brands" class="form-control"><option value="">Sin marca</option></select></div>
        <div class="col-md-3 form-group"><label asp-for="Price">Precio</label><input asp-for="Price" type="number" step="0.01" min="0" class="form-control" /><span asp-validation-for="Price" class="text-danger"></span></div>
        <div class="col-md-3 form-group"><label asp-for="Stock">Existencias</label><input asp-for="Stock" type="number" step="0.01" min="0" class="form-control" /><span asp-validation-for="Stock" class="text-danger"></span></div>
    </div>
    <div class="form-group"><label asp-for="Description">Descripción</label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div>
    <div class="form-group">
        <label asp-for="Images">Fotografías del producto (máximo 5)</label>
        <input asp-for="Images" type="file" multiple accept="image/jpeg,image/png,image/webp" class="form-control" />
        <p class="help-block">Selecciona imágenes JPG, PNG o WebP de hasta 5 MB cada una. La primera será la principal.</p>
        <span asp-validation-for="Images" class="text-danger"></span>
    </div>
    @if (Model.ExistingImages.Count > 0)
    {
        <h3>Imágenes guardadas</h3>
        <div class="row">
            @foreach (var image in Model.ExistingImages)
            {
                <div class="col-xs-6 col-sm-3">
                    <div class="thumbnail">
                        <img src="@image.Url" alt="Imagen del producto" style="height:120px;object-fit:contain" />
                        <div class="caption"><label><input type="checkbox" name="RemoveImageIds" value="@image.Id" /> Eliminar</label></div>
                    </div>
                </div>
            }
        </div>
    }
    <div id="imagePreview" class="row" aria-live="polite"></div>
    <div class="checkbox"><label><input asp-for="IsPublished" /> Publicar en catálogo</label></div>
    <button type="submit" class="btn btn-primary">Guardar producto</button>
    <a asp-action="Index" class="btn btn-default">Cancelar</a>
</form>

@section Scripts {
<script>
(function () {
    var input = document.getElementById("Images");
    var preview = document.getElementById("imagePreview");
    if (!input || !preview) return;
    input.addEventListener("change", function () {
        preview.textContent = "";
        Array.prototype.forEach.call(input.files, function (file) {
            if (!file.type.startsWith("image/")) return;
            var col = document.createElement("div");
            col.className = "col-xs-6 col-sm-3";
            var img = document.createElement("img");
            img.className = "img-responsive img-thumbnail";
            img.style.height = "120px";
            img.style.objectFit = "contain";
            img.alt = file.name;
            var url = URL.createObjectURL(file);
            img.onload = function () { URL.revokeObjectURL(url); };
            img.src = url;
            col.appendChild(img);
            preview.appendChild(col);
        });
    });
}());
</script>
}
